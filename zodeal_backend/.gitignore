# Node modules (never commit dependencies)
node_modules/

# Build output
dist/
build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by
lib-cov/

# Coverage directory used by tools like
coverage/

# TypeScript cache
*.tsbuildinfo

# Environment variables and secrets
.env
.env.*.local
secrets.txt

# OS generated files
.DS_Store
Thumbs.db

# Editor directories and files
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Optional npm cache directory
.npm/

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Parcel-bundler cache (if used)
.cache/

# Optional lock files
package-lock.json
yarn.lock

# Ignore test output
test-output/

# Ignore temporary files
*.tmp

# Ignore TypeScript declaration files (optional, if you don't want to commit them)
# *.d.ts
